{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Запуск системи",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Лише сервер",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server/server.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Тести",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["tests/test_system.py", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
